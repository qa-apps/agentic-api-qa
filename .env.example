API_BASE_URL=https://www.alexpavsky.com
API_TIMEOUT_SECONDS=10
QA_TARGET_NAME=alexpavsky
QA_ENVIRONMENT=production
QA_PRODUCTION_READ_ONLY=true
QA_REQUIRE_MUTATION_APPROVAL=true
QA_EXPLORER_ITERATIONS=4
QA_ADVERSARY_ITERATIONS=6
QA_EXPLORER_TOOL_CALLS=6
QA_ADVERSARY_TOOL_CALLS=10
QA_TOTAL_TOOL_CALLS=16

# Z.AI decision/reflection models. Keep the real key only in .env.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
QA_EXPLORER_MODEL=glm-5.3-flash
QA_ADVERSARY_MODEL=glm-5.3-flash
QA_UI_MODEL=glm-5.3-flash
QA_DESIGN_MODEL=glm-5.3-flash
QA_JUDGE_MODEL=glm-5.3-flash
QA_HEALER_MODEL=glm-5.3-flash
QA_REVIEWER_MODEL=glm-5.3-flash
QA_UI_ENABLED=true
QA_UI_HEADLESS=true
QA_UI_VIDEO=retain-on-failure
QA_SOFT_CASE_LIMIT=20
QA_HARD_CASE_LIMIT=30
QA_UI_TOOL_CALLS=300
QA_UI_ARTIFACT_DIR=artifacts/ui
QA_REPORT_DIR=reports
QA_REPORT_SERVER_ENABLED=true
QA_REPORT_SERVER_HOST=127.0.0.1
QA_REPORT_SERVER_PORT=9324
QA_AGENT_REASONING_EFFORT=high
QA_JUDGE_REASONING_EFFORT=max
QA_HEALER_REASONING_EFFORT=high
QA_REVIEWER_REASONING_EFFORT=max
QA_LLM_TIMEOUT_SECONDS=60
QA_LLM_MAX_TOKENS=1200

# Judge-confirmed fixes only. The Healer uses a new worktree from origin/main,
# creates a draft PR, and has no merge capability.
QA_HEALER_ENABLED=true
QA_HEALER_ITERATIONS=8
QA_REVIEWER_REVISION_ROUNDS=2
QA_JUDGE_MIN_CONFIDENCE=0.85
QA_HEALER_SOURCE_REPO=/Users/alex/Projects/alexpavsky
QA_HEALER_REMOTE=origin
QA_HEALER_BASE_BRANCH=main
QA_HEALER_GITHUB_REPOSITORY=qa-apps/alexpavsky
QA_HEALER_WORKTREE_ROOT=.healer-worktrees
QA_HEALER_DRAFT_PR=true

# Slack bot needs chat:write and files:write. Keep the token only in .env/CI.
SLACK_BOT_TOKEN=
QA_HUMAN_REVIEW_CHANNEL_ID=C0C1L0GNHE0

# Optional cloud tracing. Local Studio works through the Agent Server without these.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ap-agents-interview-rehearsal

# Optional second observability backend. The shown URL is the Langfuse US region.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=production
LANGFUSE_TRACING_ENABLED=true

# Paid evaluation layer (installed separately with .[evals]).
# The judge must differ from Explorer/Adversary/UI models.
QA_EVAL_DEEPEVAL=true
QA_EVAL_JUDGE_MODEL=glm-5.3
QA_EVAL_JUDGE_BASE_URL=https://api.z.ai/api/paas/v4/
QA_EVAL_JUDGE_REASONING_EFFORT=high
QA_EVAL_JUDGE_MAX_TOKENS=2000
QA_EVAL_JUDGE_TIMEOUT_SECONDS=120
QA_EVAL_DECISION_THRESHOLD=0.6
QA_EVAL_FINDING_THRESHOLD=0.6
QA_EVAL_SITE_SOURCE=/Users/alex/Projects/alexpavsky
QA_EVAL_SITE_HOST=127.0.0.1
QA_EVAL_SITE_PORT=0
QA_EVAL_SEEDED_API_CASES=6
QA_EVAL_SEEDED_UI_CASES=8
QA_EVAL_SEEDED_UI_ENABLED=true
QA_EVAL_MUTATION_SEED=1337
QA_EVAL_MUTATION_COUNT=0
QA_EVAL_REPORT_DIR=reports/evals
QA_EVAL_SLACK_ENABLED=true
QA_EVAL_SLACK_CHANNEL_ID=C0BPQTUS2DR

# Optional published prices used only for estimated USD cost reporting.
QA_EVAL_AGENT_INPUT_USD_PER_MILLION=
QA_EVAL_AGENT_OUTPUT_USD_PER_MILLION=
QA_EVAL_JUDGE_INPUT_USD_PER_MILLION=
QA_EVAL_JUDGE_OUTPUT_USD_PER_MILLION=
